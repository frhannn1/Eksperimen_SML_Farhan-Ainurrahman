    {
      "cell_type": "code",
      "source": [
        "# Melakukan Handling Outlier Data berdasarkan jumlah outlier, apakah menggunakan metode drop atau mengisi nilai tersebut.\n",
        "print(f\"Jumlah baris sebelum menghilangkan outlier: {len(data_pre)}\")\n",
        "\n",
        "# Tentukan kolom numerik yang ingin dibersihkan dari outlier\n",
        "numeric_cols = ['TransactionAmount', 'TransactionDuration', 'LoginAttempts']\n",
        "\n",
        "for col in numeric_cols:\n",
        "    # Hitung Q1, Q3, dan IQR\n",
        "    Q1 = data_pre_clean[col].quantile(0.25)\n",
        "    Q3 = data_pre_clean[col].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "\n",
        "    # Tentukan batas bawah dan atas\n",
        "    lower_bound = Q1 - 1.5 * IQR\n",
        "    upper_bound = Q3 + 1.5 * IQR\n",
        "\n",
        "    # Simpan baris yang bukan outlier\n",
        "    data_pre_clean = data_pre_clean[(data_pre_clean[col] >= lower_bound) & (data_pre_clean[col] <= upper_bound)]\n",
        "\n",
        "print(f\"Jumlah baris setelah menghilangkan outlier: {len(data_pre_clean)}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "HLOGmmF7LQXI",
        "outputId": "772262ff-8c19-43a7-db81-28bf633d134e"
