      "source": [
        "# Melakukan feature encoding menggunakan LabelEncoder() untuk fitur kategorikal.\n",
        "# Pastikan kamu menggunakan function head setelah melalukan encoding.\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "encoders = {}  # untuk menyimpan encoder tiap kolom\n",
        "categorical_cols = ['Channel', 'TransactionType', 'Location_Grouped','CustomerOccupation']\n",
        "\n",
        "# Encoding\n",
        "for col in categorical_cols:\n",
        "    le = LabelEncoder()\n",
        "    data_pre[col] = le.fit_transform(data_pre[col])\n",
        "    encoders[col] = le  # simpan encoder untuk kolom ini\n",
        "\n",
        "print(\"\\n--- Data Setelah Encoding ---\")\n",
        "display(data_pre)\n"
      ],
